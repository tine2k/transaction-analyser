# The database address and its credentials, read at run time by server/utils/db.ts.
# Set this in your shell's environment, or in a .env file, which is not committed.
# Required: the server applies the pending migrations at startup and exits with a
# failure when the address is missing or the database cannot be reached.
DATABASE_URL=

# One-time adoption of a database whose schema was applied by hand before the
# migration history existed: the migration files up to and including this version
# are recorded as applied without executing them, and later files are applied
# normally. It is ignored once the database records migrations, so leaving it set
# is harmless. Use the highest applied file version, for example 0008.
MIGRATE_BASELINE=

# The Easybank credentials the nightly sync and the sync command use. Set them in
# the environment or in a .env file, which is not committed. Without them the sync
# does nothing and records no run.
EASYBANK_USER=
EASYBANK_PIN=

# The person the nightly sync and the sync command import into. Unset or empty
# means Default. The person must already exist; rename Default on the People
# screen and set this to the new name, or the sync fails until it is corrected.
EASYBANK_PERSON=

# Set to true to let the nightly sync write. Until then it runs non-writing: it
# records what it would import and changes no transaction.
EASYBANK_SYNC_WRITE=

# Optional: point the sync at a test bank instead of the real Easybank site.
# Unset means the real bank. Useful for trying the sync without touching it.
EASYBANK_BASE_URL=
