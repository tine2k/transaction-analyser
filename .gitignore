# The import source is a statement the user holds outside the repository.
# Never commit one, wherever it is dropped.
*.csv

node_modules/

# pnpm's content-addressable store, kept on the same volume as node_modules.
.pnpm-store/

# Generated by Nuxt: types, path aliases, and development build output.
.nuxt/

# Build output of `nuxt build`.
.output/

# Environment files hold the database address and its credentials. The name of
# the variable is discoverable in .env.example; its value is not committed.
.env
.env.*
!.env.example

# Database backups contain private transaction data.
backups/

# Playwright browser-test output.
test-results/
playwright-report/
