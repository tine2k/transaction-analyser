{
  "$schema": "https://opencode.ai/config.json",
  // V1 groups permission rules by tool. Keep broad rules first and exceptions last.
  "permission": {
    "bash": {
      "*": "ask",

      // Read-only git inspection
      "git status *": "allow",
      "git diff *": "allow",

      // Filesystem inspection
      "pwd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "od *": "allow",
      "grep *": "allow",
      "tar *": "allow",
      "cut *": "allow",
      "sed *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "pgrep *": "allow",
      "pkill *": "allow",
      "lsof *": "allow",
      "xargs *": "allow",
      "ipconfig *": "allow",
      "sleep *": "allow",

      // Directory creation
      "mkdir *": "allow",

      // Toolchain and environment lookup
      "which *": "allow",
      "npm *": "allow",
      "npx playwright *": "allow",
      "brew list *": "allow",
      "openspec *": "allow",

      // Output and scripting
      "echo *": "allow",
      "printf *": "allow",
      "show *": "allow",
      "j *": "allow",
      "command *": "allow",
      "set *": "allow",
      "trap *": "allow",
      "break *": "allow",
      "true *": "allow",
      "test *": "allow",
      "tee *": "allow",
      "node *": "allow",
      "python3 *": "allow",
      "whoami *": "allow",
      "exit *": "allow",

      // Network
      "curl *": "allow",

      // Database
      "psql *": "allow",
      "postgres *": "allow",
      "pg_isready *": "allow",
      "createdb *": "allow",
      "dropdb *": "allow",

      // Docker
      "docker *": "allow",
      "docker-compose *": "allow",

      // Hard deny
      "git push *": "deny"
    }
  }
}
